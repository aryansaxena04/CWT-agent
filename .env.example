# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ad scraping (Apify) ---
APIFY_API_TOKEN=
# Actor id for the Meta Ads Library scraper. Several equivalent ones exist on
# the Apify store; this is the default this project's field-mapping assumes.
APIFY_META_ADS_ACTOR=curious_coder/facebook-ads-library-scraper

# --- Search ---
TAVILY_API_KEY=
EXA_API_KEY=

# --- Video rendering ---
# Optional: absolute path to a local clone of calesthio/OpenMontage. If unset
# or missing pipeline_defs/, the built-in fallback renderer is used instead.
OPENMONTAGE_PATH=
# Required only for the fallback renderer (free tier is enough).
PEXELS_API_KEY=
# Voiceover uses Microsoft Edge neural TTS (free, no key needed). Override the
# voice/rate/pitch here. `python -m src.tools.list_voices` prints the options.
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=+8%
TTS_PITCH=-2Hz
